# TOSKINSTALLER - ToskeraLAB Theme
# Tema oficial ToskeraLAB ART/TECH House

MainWindow {
    background-color: #0a0a0f;
}

QWidget {
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QLabel {
    color: #ffffff;
    background-color: transparent;
}

QLabel#title {
    font-size: 26px;
    font-weight: bold;
    color: #ff006e;
    text-transform: uppercase;
    letter-spacing: 2px;
}

QLabel#subtitle {
    font-size: 16px;
    color: #8338ec;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff006e, stop:1 #8338ec);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 24px;
    font-weight: bold;
    min-width: 120px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #fb5607, stop:1 #ff006e);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #8338ec, stop:1 #ff006e);
}

QPushButton:disabled {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #3a3a4a, stop:1 #4a4a5a);
    color: #6a6a7a;
}

QPushButton#nextButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #00f5d4, stop:1 #00bbf9);
    color: #0a0a0f;
}

QPushButton#nextButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #00bbf9, stop:1 #00f5d4);
}

QPushButton#backButton {
    background: transparent;
    color: #8338ec;
    border: 2px solid #8338ec;
}

QPushButton#backButton:hover {
    background: #8338ec;
    color: white;
}

QLineEdit {
    border: 2px solid #8338ec;
    border-radius: 6px;
    padding: 10px;
    background-color: #1a1a2e;
    color: #ffffff;
    selection-background-color: #ff006e;
    selection-color: white;
}

QLineEdit:focus {
    border: 2px solid #ff006e;
}

QTextEdit {
    border: 2px solid #8338ec;
    border-radius: 6px;
    padding: 10px;
    background-color: #1a1a2e;
    color: #ffffff;
}

QComboBox {
    border: 2px solid #8338ec;
    border-radius: 6px;
    padding: 10px;
    background-color: #1a1a2e;
    color: #ffffff;
    min-width: 150px;
}

QComboBox:focus {
    border: 2px solid #ff006e;
}

QComboBox::drop-down {
    width: 35px;
    border: none;
}

QComboBox::down-arrow {
    image: none;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid #ff006e;
    margin-right: 12px;
}

QCheckBox {
    spacing: 12px;
    color: #ffffff;
    font-weight: normal;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #8338ec;
    border-radius: 6px;
    background-color: #1a1a2e;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #ff006e, stop:1 #8338ec);
    border: 2px solid #ff006e;
}

QCheckBox::indicator:hover {
    border: 2px solid #ff006e;
}

QRadioButton {
    spacing: 12px;
    color: #ffffff;
}

QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #8338ec;
    border-radius: 11px;
    background-color: #1a1a2e;
}

QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
        stop:0 #ff006e, stop:1 #8338ec);
    border: 2px solid #ff006e;
}

QProgressBar {
    border: 2px solid #8338ec;
    border-radius: 8px;
    background-color: #1a1a2e;
    height: 30px;
    text-align: center;
    color: #ffffff;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff006e, stop:0.5 #fb5607, stop:1 #ffbe0b);
    border-radius: 6px;
}

QGroupBox {
    border: 2px solid #8338ec;
    border-radius: 8px;
    margin-top: 18px;
    padding-top: 18px;
    font-weight: bold;
    color: #ff006e;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
    color: #ff006e;
    text-transform: uppercase;
    letter-spacing: 1px;
}

QListWidget {
    border: 2px solid #8338ec;
    border-radius: 8px;
    background-color: #1a1a2e;
    color: #ffffff;
    outline: none;
}

QListWidget::item {
    padding: 12px;
    border-bottom: 1px solid #2a2a3e;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff006e, stop:1 #8338ec);
    color: white;
}

QListWidget::item:hover {
    background-color: #2a2a3e;
}

QTabWidget::pane {
    border: 2px solid #8338ec;
    border-radius: 8px;
    background-color: #1a1a2e;
}

QTabBar::tab {
    background-color: #1a1a2e;
    border: 2px solid #2a2a3e;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 12px 24px;
    margin-right: 4px;
    color: #8338ec;
    font-weight: bold;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #ff006e, stop:1 #8338ec);
    border-bottom: 2px solid #1a1a2e;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #2a2a3e;
    color: #ff006e;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #1a1a2e;
    width: 14px;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff006e, stop:1 #8338ec);
    border-radius: 7px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #fb5607, stop:1 #ff006e);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QFrame#separator {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #ff006e, stop:0.5 #8338ec, stop:1 #00f5d4);
    max-height: 3px;
}

QFrame#wizardContainer {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
        stop:0 #0a0a0f, stop:1 #1a1a2e);
    border-radius: 12px;
    border: 2px solid #8338ec;
}

QFrame#headerFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
        stop:0 #0a0a0f, stop:0.5 #1a1a2e, stop:1 #0a0a0f);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 2px solid #8338ec;
}

QFrame#footerFrame {
    background-color: #1a1a2e;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top: 1px solid #2a2a3e;
}

/* Efeito de brilho em elementos selecionados */
QWidget:focus {
    outline: 2px solid #00f5d4;
    outline-offset: 2px;
}
